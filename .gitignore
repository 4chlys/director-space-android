.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/caches/
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/.name
.idea/markdown.xml

