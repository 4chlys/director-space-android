# ANDROID
# =============================================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Dalvik
*.dex

# Java class files
*.class

# Generated output
bin/
gen/
out/
release/

# Gradle caches and build output
.gradle/
build/
**/build/
!src/**/build/

# Keep Gradle wrapper files
!gradle/wrapper/gradle-wrapper.jar
