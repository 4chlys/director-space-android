# Gradle GUI config
gradle-app.setting
.gradletasknamecache

# Local machine config (SDK path, signing)
local.properties
keystore.properties
signing.properties
release.properties

# Kotlin module metadata
*.kotlin_module

# IntelliJ module files
*.iml

# Native build
.externalNativeBuild/
.cxx/

# Android Studio captures / profiling
captures/
*.hprof

# Navigation editor temp files
.navigation/

# Keystore files
*.jks
*.keystore

# Log files
*.log

